# Copy to .env and fill in. Never commit the real file.

# Database (docker compose creates the database for you; point DB_URL elsewhere for a managed Postgres)
DB_PASSWORD=change-me

# Signing key for access tokens - Base64, at least 256 bits:  openssl rand -base64 48
JWT_SECRET=

# Browser origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# First administrator, created only when the database has no users yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# Set to true to populate an empty database with a demo team (accounts 'admin' and 'member', password Demo@2024)
DEMO_DATA=false
